PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=a-very-long-secure-random-key-replace-me-in-production
LOG_LEVEL=info

# MongoDB connection string
MONGO_URI=mongodb://root:example@localhost:27017/adonis_db?authSource=admin

# JWT Secrets
JWT_ACCESS_SECRET=your-access-token-secret-key-change-me
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
FROM_EMAIL=noreply@example.com
