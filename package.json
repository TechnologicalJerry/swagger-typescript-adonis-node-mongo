{
  "name": "adonis-mongodb-swagger-api",
  "version": "1.0.0",
  "description": "Scalable AdonisJS API with MongoDB and Swagger",
  "main": "bin/server.js",
  "type": "module",
  "files": [
    "build/bin",
    "build/app",
    "build/config",
    "build/start",
    "build/providers"
  ],
  "scripts": {
    "dev": "node --loader ts-node/esm bin/server.ts",
    "build": "node --loader ts-node/esm bin/console.ts build",
    "start": "node build/bin/server.js",
    "lint": "eslint . --ext=.ts"
  },
  "dependencies": {
    "@adonisjs/core": "^6.2.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/fold": "^10.1.2",
    "@adonisjs/logger": "^3.0.0",
    "@vinejs/vine": "^2.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "edge.js": "^6.0.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "nodemailer": "^8.0.7",
    "pino": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-dist": "^5.17.14"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.5.0",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "eslint": "^8.57.0",
    "pino-pretty": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
