{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "paths": {
      "#app/*": ["./app/*"],
      "#config/*": ["./config/*"],
      "#start/*": ["./start/*"],
      "#providers/*": ["./providers/*"]
    }
  }
}
